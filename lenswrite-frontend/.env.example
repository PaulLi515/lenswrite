# Public API base URL (browser calls this). No trailing slash.
# Local:
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# Production (Railway/Render example):
# NEXT_PUBLIC_API_BASE=https://lenswrite-api.up.railway.app

# Local VPN proxy only if your machine needs it for npm/outbound.
# Cloud Vercel: leave unset.
# VPN_HTTP_PROXY=
# HTTP_PROXY=
# HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,0.0.0.0
