# --- Required (production + local) ---
XAI_API_KEY=

# Optional model override (default grok-3)
# XAI_MODEL=grok-3
# XAI_BASE_URL=https://api.x.ai/v1

# --- CORS: Vercel origin(s), comma-separated, no trailing slash ---
# Example: https://lenswrite.vercel.app,https://lenswrite-git-main-xxx.vercel.app
CORS_ORIGINS=http://localhost:3000
# Optional: allow all https://*.vercel.app (set to 1 or vercel)
# CORS_ORIGIN_REGEX=1
# Keep local Next dev allowed (default 1)
CORS_ALLOW_LOCAL=1

# --- Outbound HTTP proxy (local VPN only; leave unset/0 in production) ---
USE_HTTP_PROXY=0
# VPN_HTTP_PROXY=http://127.0.0.1:4780
# HTTPS_PROXY=
# HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,0.0.0.0

# Cloud injects PORT automatically (Railway/Render)
# PORT=8000
